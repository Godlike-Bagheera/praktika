DJANGO_SECRET_KEY=замените_на_случайную_строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,IP_виртуальной_машины
CSRF_TRUSTED_ORIGINS=http://IP_виртуальной_машины:8084
DB_HOST=db
DB_PORT=5432
DB_NAME=forumdb
DB_USER=forumuser
DB_PASSWORD=замените_на_случайный_пароль
POSTGRES_DB=forumdb
POSTGRES_USER=forumuser
POSTGRES_PASSWORD=замените_на_случайный_пароль

# CORS (только если фронтенд открывается с другого домена, чем API)
# В production CORS_ALLOW_ALL игнорируется (всегда False); перечислите
# свои домены через запятую. Для этого форума nginx проксирует /api на том
# же origin, поэтому переменную можно оставить пустой.
# Пример: CORS_ALLOWED_ORIGINS=https://forum.example.com,https://www.forum.example.com
CORS_ALLOWED_ORIGINS=

# Secure-флаг для httpOnly-кук авторизации (forum_access/forum_refresh).
# По умолчанию 1 (включён) — безопасно для production за HTTPS.
# Ставьте 0 ТОЛЬКО для локальной разработки по чистому HTTP (http://localhost),
# иначе браузер не примет куки. При DJANGO_SECURE_COOKIES=0 и DEBUG=False
# Django выведет предупреждение в лог при старте.
DJANGO_SECURE_COOKIES=1
